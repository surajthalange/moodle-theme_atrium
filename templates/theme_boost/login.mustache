{{!
    @template theme_boost/login

    Atrium override of theme_boost/login: one card centred in the viewport over a
    full-bleed background. Works on 5.1, which renders the form straight into the page,
    and on 5.2, which introduced the split core/login_layout this replaces.

    The background and its colour wash are painted by .atrium-login-page in the theme
    stylesheet, not here, so an administrator changing the image never touches markup.
    The region-main and region-main-box ids are kept because core CSS and Behat steps
    both address them. The card is its own element rather than a class on #region-main:
    core styles region-main by id, and an id beats a class.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * leftinstructions - Formatted auth instructions for the panel beside the card, or null

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
        },
        "bodyattributes": "",
        "leftinstructions": "<p>Sign in with your student number.</p>"
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="mt-0">
        <div id="page-content" class="atrium-login-page">
            <div class="atrium-login-card">
                <main id="region-main">
                    <div id="region-main-box">
                        <div class="login-container">
                            {{{ output.main_content }}}
                        </div>
                    </div>
                </main>
            </div>
            {{#leftinstructions}}
                <aside class="atrium-login-instructions d-none d-lg-block">
                    {{{ leftinstructions }}}
                </aside>
            {{/leftinstructions}}
        </div>
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
