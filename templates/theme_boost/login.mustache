{{!
    @template theme_boost/login

    Atrium override of theme_boost/login: one card centred in the viewport over a
    full-bleed background. Works on 5.1, which renders the form straight into the page,
    and on 5.2, which introduced the split core/login_layout this replaces.

    The background and its colour wash are painted by .atrium-login-page in the theme
    stylesheet, not here, so an administrator changing the image never touches markup.
    The region-main and region-main-box ids are kept because core CSS and Behat steps
    both address them. The card is its own element rather than a class on #region-main:
    core styles region-main by id, and an id beats a class.

    Three layouts, named by the login.layout setting: the card centred over the image,
    or the card beside an image panel on the left or the right. The panel carries the
    panel heading and text and, on 5.2, the auth instructions.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * leftinstructions - Formatted auth instructions for the panel beside the card, or null
    * login - Layout context: layout, panel, panelheading, paneltext, textabove, textbelow

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
        },
        "bodyattributes": "",
        "leftinstructions": "<p>Sign in with your student number.</p>",
        "login": {
            "layout": "panelleft",
            "panel": true,
            "panelheading": "Welcome back",
            "paneltext": "<p>Pick up where you left off.</p>",
            "textabove": "",
            "textbelow": "<p>Need help? Call the service desk.</p>"
        }
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="mt-0">
        <div id="page-content" class="atrium-login-page atrium-login-page-{{ login.layout }}">
            {{#login.panel}}
                <aside class="atrium-login-panel">
                    <div class="atrium-login-panel-content">
                        {{#login.panelheading}}
                            <h2 class="atrium-login-panel-heading">{{ login.panelheading }}</h2>
                        {{/login.panelheading}}
                        {{#login.paneltext}}
                            <div class="atrium-login-panel-text">{{{ login.paneltext }}}</div>
                        {{/login.paneltext}}
                        {{#leftinstructions}}
                            <div class="atrium-login-instructions">{{{ leftinstructions }}}</div>
                        {{/leftinstructions}}
                    </div>
                </aside>
            {{/login.panel}}
            <div class="atrium-login-main">
                <div class="atrium-login-card">
                    {{#login.textabove}}
                        <div class="atrium-login-text atrium-login-text-above">{{{ login.textabove }}}</div>
                    {{/login.textabove}}
                    <main id="region-main">
                        <div id="region-main-box">
                            <div class="login-container">
                                {{{ output.main_content }}}
                            </div>
                        </div>
                    </main>
                    {{#login.textbelow}}
                        <div class="atrium-login-text atrium-login-text-below">{{{ login.textbelow }}}</div>
                    {{/login.textbelow}}
                </div>
                {{^login.panel}}
                    {{#leftinstructions}}
                        <aside class="atrium-login-instructions d-none d-lg-block">
                            {{{ leftinstructions }}}
                        </aside>
                    {{/leftinstructions}}
                {{/login.panel}}
            </div>
        </div>
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
