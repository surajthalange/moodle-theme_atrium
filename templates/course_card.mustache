{{!
    @template theme_atrium/course_card

    One course as a card, used by the front page showcase, the catalogue and the
    enrolment page's related courses.

    Context variables required for this template:
    * id - Course id
    * url - Course URL
    * fullname - Formatted course name
    * summary - Short plain-text summary
    * imageurl - Course image URL, or empty
    * gradient - Gradient class to use when there is no image
    * category, categoryurl - Category name and link
    * contacts - Teachers: name, pictureurl, url
    * showenrolled, enrolledcount - Enrolled user count
    * showactivities, activitycount - Visible activity count
    * enrolled - Whether the viewer is enrolled
    * hasprogress, progress - Completion percentage for the viewer
    * hidden - Whether the course is hidden from learners
    * hasprice, price - A formatted price badge

    Example context (json):
    {
        "id": 2,
        "url": "/course/view.php?id=2",
        "fullname": "Introduction to Biology",
        "summary": "Cells, genetics and evolution in one term.",
        "imageurl": "",
        "gradient": "atrium-gradient-2",
        "category": "Science",
        "categoryurl": "/course/index.php?categoryid=1",
        "contacts": [{"name": "Grace Hopper", "pictureurl": "/user/pix.php/3/f2.jpg", "url": "/user/view.php?id=3"}],
        "showenrolled": true,
        "enrolledcount": 128,
        "showactivities": true,
        "activitycount": 12,
        "enrolled": true,
        "hasprogress": true,
        "progress": 40,
        "hidden": false,
        "hasprice": true,
        "price": "US$ 49.00"
    }
}}
<article class="atrium-course-card{{#hidden}} atrium-course-card-hidden{{/hidden}}" data-courseid="{{ id }}">
    <a href="{{{ url }}}" class="atrium-course-card-media {{ gradient }}" aria-hidden="true" tabindex="-1">
        {{#imageurl}}<img src="{{{ imageurl }}}" alt="" loading="lazy">{{/imageurl}}
        {{#hidden}}<span class="atrium-course-card-badge">{{#str}} hiddenfromstudents, core {{/str}}</span>{{/hidden}}
        {{^hidden}}{{#enrolled}}<span class="atrium-course-card-badge atrium-course-card-badge-enrolled">{{#str}} enrolledbadge, theme_atrium {{/str}}</span>{{/enrolled}}{{/hidden}}
        {{#hasprice}}{{^enrolled}}<span class="atrium-course-card-badge atrium-course-card-badge-price">{{ price }}</span>{{/enrolled}}{{/hasprice}}
    </a>
    <div class="atrium-course-card-body">
        {{#category}}
            <a href="{{{ categoryurl }}}" class="atrium-course-card-category">{{ category }}</a>
        {{/category}}
        <h3 class="atrium-course-card-title">
            <a href="{{{ url }}}">{{ fullname }}</a>
        </h3>
        {{#summary}}<p class="atrium-course-card-summary">{{ summary }}</p>{{/summary}}
        {{#hasprogress}}
            <div class="atrium-course-card-progress">
                <div class="progress" role="progressbar" aria-label="{{#str}} progress, core {{/str}}" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: {{ progress }}%"></div>
                </div>
                <span class="atrium-course-card-progress-text">{{ progress }}%</span>
            </div>
        {{/hasprogress}}
    </div>
    <div class="atrium-course-card-foot">
        <div class="atrium-course-card-contacts">
            {{#contacts}}
                <a href="{{{ url }}}" class="atrium-course-card-contact" title="{{ name }}">
                    <img src="{{{ pictureurl }}}" alt="{{ name }}" loading="lazy">
                </a>
            {{/contacts}}
            {{#firstcontactname}}<span class="atrium-course-card-contact-name">{{ firstcontactname }}</span>{{/firstcontactname}}
        </div>
        {{#showactivities}}
            <span class="atrium-course-card-activities" title="{{#str}} activities, core {{/str}}">
                {{#pix}} i/course, core {{/pix}}{{ activitycount }}
            </span>
        {{/showactivities}}
        {{#showenrolled}}
            <span class="atrium-course-card-enrolled" title="{{#str}} enrolledusers, enrol {{/str}}">
                {{#pix}} i/users, core {{/pix}}{{ enrolledcount }}
            </span>
        {{/showenrolled}}
    </div>
</article>
