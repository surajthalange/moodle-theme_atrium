{{!
    @template theme_atrium/profile_category

    One profile category as a card: an icon, the title and core's rendered nodes.

    Context variables required for this template:
    * name - Category name (contact, coursedetails, ...)
    * title - Category title
    * icon - Font Awesome class
    * classes - Extra classes core asked for
    * items - Rendered node list items

    Example context (json):
    {
        "name": "contact",
        "title": "User details",
        "icon": "fa-address-card",
        "classes": "",
        "items": ["<li class=\"contentnode\"><dl><dt>Email address</dt><dd>ada@example.com</dd></dl></li>"]
    }
}}
<section class="node_category atrium-profile-card atrium-profile-card-{{ name }} {{ classes }}">
    <h3 class="atrium-profile-card-title">
        <span class="atrium-profile-card-icon" aria-hidden="true"><i class="fa {{ icon }}"></i></span>
        {{ title }}
    </h3>
    <ul class="atrium-profile-card-list list-unstyled">
        {{#items}}
            {{{ . }}}
        {{/items}}
    </ul>
</section>
