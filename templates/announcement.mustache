{{!
    @template theme_atrium/announcement

    The site-wide announcement bar above the page.

    Context variables required for this template:
    * text - Formatted announcement HTML
    * type - info, success, warning or danger
    * dismissible - Whether the current user may dismiss it
    * hash - Identifies the announcement text for dismissal

    Example context (json):
    {
        "text": "<p>Maintenance on Saturday from 08:00 to 10:00.</p>",
        "type": "warning",
        "dismissible": true,
        "hash": "abc123"
    }
}}
<div class="atrium-announcement atrium-announcement-{{ type }}" data-region="atrium-announcement" data-hash="{{ hash }}" role="status">
    <div class="atrium-announcement-text">{{{ text }}}</div>
    {{#dismissible}}
        <form method="post" action="{{ config.wwwroot }}/theme/atrium/announcement.php" class="atrium-announcement-dismiss">
            <input type="hidden" name="sesskey" value="{{ config.sesskey }}">
            <input type="hidden" name="hash" value="{{ hash }}">
            <button type="submit" class="btn btn-icon" data-action="atrium-announcement-dismiss"
                    aria-label="{{#str}} announcement_dismiss, theme_atrium {{/str}}" title="{{#str}} announcement_dismiss, theme_atrium {{/str}}">
                {{#pix}} e/cancel, core {{/pix}}
            </button>
        </form>
    {{/dismissible}}
</div>
