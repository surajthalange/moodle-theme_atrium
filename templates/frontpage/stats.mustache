{{!
    @template theme_atrium/frontpage/stats

    Stats strip: up to four counters.

    Context variables required for this template:
    * items - Counters: label, value (already resolved)

    Example context (json):
    {
        "items": [
            {
                "label": "Courses",
                "value": "42"
            },
            {
                "label": "Learners",
                "value": "1,200"
            }
        ]
    }
}}
<section class="atrium-fp-section atrium-fp-stats" data-region="atrium-fp-stats">
    <div class="atrium-fp-container">
        <ul class="atrium-fp-stat-list list-unstyled">
            {{#items}}
                <li class="atrium-fp-stat">
                    <span class="atrium-fp-stat-value">{{ value }}</span>
                    <span class="atrium-fp-stat-label">{{ label }}</span>
                </li>
            {{/items}}
        </ul>
    </div>
</section>
