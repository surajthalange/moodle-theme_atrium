{{!
    @template theme_atrium/dashboard_hero

    The greeting band and progress tiles at the top of the dashboard.

    Context variables required for this template:
    * greeting - The greeting line, already formatted
    * date - Today's date, localised
    * hastiles - Whether any tiles are enabled
    * tiles - Tiles: key, icon, url, count, label, help
    * hasimage - Whether a background image is configured

    Example context (json):
    {
        "greeting": "Welcome back, Ada",
        "date": "Monday, 14 September 2026",
        "hasimage": false,
        "hastiles": true,
        "tiles": [
            {"key": "inprogress", "icon": "inprogress", "url": "/my/courses.php", "count": 3, "label": "In progress", "help": ""},
            {"key": "completed", "icon": "completed", "url": "/my/courses.php", "count": 5, "label": "Completed", "help": ""},
            {"key": "due", "icon": "due", "url": "/calendar/view.php?view=upcoming", "count": 2, "label": "Due this week", "help": ""},
            {"key": "unread", "icon": "unread", "url": "/message/index.php", "count": 1, "label": "Unread", "help": "Unread messages and notifications"}
        ]
    }
}}
<section class="atrium-hero{{#hasimage}} atrium-hero-has-image{{/hasimage}}" data-region="atrium-hero" aria-label="{{ greeting }}">
    <div class="atrium-hero-inner">
        <div class="atrium-hero-text">
            <p class="atrium-hero-date">{{ date }}</p>
            <p class="atrium-hero-greeting">{{ greeting }}</p>
        </div>
        {{#hastiles}}
            <ul class="atrium-stat-tiles list-unstyled m-0">
                {{#tiles}}
                    <li class="atrium-stat-tile atrium-stat-{{ key }}">
                        <a href="{{{ url }}}" class="atrium-stat-link"{{#help}} title="{{ help }}"{{/help}}>
                            <span class="atrium-stat-icon" aria-hidden="true">{{#pix}} {{ icon }}, theme_atrium {{/pix}}</span>
                            <span class="atrium-stat-body">
                                <span class="atrium-stat-count">{{ count }}</span>
                                <span class="atrium-stat-label">{{ label }}</span>
                            </span>
                        </a>
                    </li>
                {{/tiles}}
            </ul>
        {{/hastiles}}
    </div>
</section>
