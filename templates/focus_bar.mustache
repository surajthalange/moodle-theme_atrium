{{!
    @template theme_atrium/focus_bar

    The slim bar that replaces the navigation bar in focus mode.

    Context variables required for this template:
    * courseurl, fullname - The course
    * hasprogress, progress - The learner's completion
    * exiturl - Link that switches focus mode off

    Example context (json):
    {
        "courseurl": "/course/view.php?id=2",
        "fullname": "Marine Biology",
        "hasprogress": true,
        "progress": 40,
        "exiturl": "/theme/atrium/focus.php?state=0"
    }
}}
<div class="atrium-focus-bar" data-region="atrium-focus-bar">
    <a href="{{{ courseurl }}}" class="atrium-focus-bar-course">
        {{#pix}} i/course, core {{/pix}}<span>{{ fullname }}</span>
    </a>
    {{#hasprogress}}
        <span class="atrium-focus-bar-progress" role="progressbar" aria-label="{{#str}} progress, core {{/str}}"
              aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
            <span class="atrium-focus-bar-track"><span class="atrium-focus-bar-fill" style="width: {{ progress }}%"></span></span>
            <span class="atrium-focus-bar-text">{{ progress }}%</span>
        </span>
    {{/hasprogress}}
    <a href="{{{ exiturl }}}" class="btn btn-outline-secondary btn-sm atrium-focus-bar-exit" data-action="atrium-focus-toggle">
        {{#pix}} exitfocus, theme_atrium {{/pix}}{{#str}} focus_exit, theme_atrium {{/str}}
    </a>
</div>
