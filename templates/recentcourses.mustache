{{!
    @template theme_atrium/recentcourses

    The recent courses menu in the navigation bar.

    Context variables required for this template:
    * courses - Courses: id, name, url, hasimage, imageurl, gradient
    * allurl - URL of the My courses page

    Example context (json):
    {
        "courses": [
            {"id": 2, "name": "Biology 101", "url": "/course/view.php?id=2", "hasimage": false, "imageurl": "", "gradient": "atrium-gradient-2"},
            {"id": 3, "name": "Marine Biology", "url": "/course/view.php?id=3", "hasimage": true, "imageurl": "https://placekitten.com/80/50", "gradient": ""}
        ],
        "allurl": "/my/courses.php"
    }
}}
<div class="dropdown atrium-recentcourses">
    <button class="btn btn-icon icon-no-margin atrium-recentcourses-toggle" type="button" data-bs-toggle="dropdown"
            aria-expanded="false" aria-label="{{#str}} recentcourses, theme_atrium {{/str}}" title="{{#str}} recentcourses, theme_atrium {{/str}}">
        {{#pix}} inprogress, theme_atrium {{/pix}}
    </button>
    <div class="dropdown-menu dropdown-menu-end atrium-recentcourses-menu">
        <p class="atrium-recentcourses-heading">{{#str}} recentcourses, theme_atrium {{/str}}</p>
        <ul class="list-unstyled m-0" data-region="atrium-recentcourses">
            {{#courses}}
                <li>
                    <a href="{{{ url }}}" class="dropdown-item atrium-recentcourse">
                        <span class="atrium-recentcourse-image {{ gradient }}"{{#hasimage}} style="background-image: url('{{{ imageurl }}}');"{{/hasimage}} aria-hidden="true"></span>
                        <span class="atrium-recentcourse-name">{{ name }}</span>
                    </a>
                </li>
            {{/courses}}
        </ul>
        <a href="{{{ allurl }}}" class="dropdown-item atrium-recentcourses-all">{{#str}} mycourses, core {{/str}}</a>
    </div>
</div>
